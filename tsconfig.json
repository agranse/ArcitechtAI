{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "analyzer",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["analyzer/**/*.ts", "analyzer/parsers/js/index.js"],
  "exclude": ["node_modules", "dist"]
}
